# Copy to .env and adjust. Never commit real secrets.
POSTGRES_PASSWORD=porter
DATABASE_URL=postgresql://porter:porter@localhost:5432/porter

# ---- Embedder ----
# hash | bge-m3 | qwen3 | harrier | embeddinggemma | openai | http
# Local default: bge-m3 (Docker) / hash (dev fallback). qwen3/harrier are
# challengers — run scripts/eval_embeddings.py before switching default.
PORTER_EMBEDDER=bge-m3
# EMBEDDER_KIND is kept as a legacy alias for PORTER_EMBEDDER.
# CPU inference threads in the Docker embedder (default 2).
# PORTER_EMBED_THREADS=2
EMBEDDER_URL=http://embedder:8001
# OPENAI_API_KEY=   # only if PORTER_EMBEDDER=openai (sends memory text to OpenAI!)

# ---- Auth ----
# Bearer-token auth is ON by default. Set to 0 for local dev only.
AUTH_ENABLED=1
# Exact HTTP hostnames/IPs (no scheme, port or wildcard). Custom domains
# require owner login even when an upstream proxy connects over loopback.
# PORTER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For TLS terminated by a reverse proxy, set both the exact allowed host
# and its public origin; forwarded headers remain disabled.
# PORTER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],memory.example.com
# PORTER_PUBLIC_ORIGIN=https://memory.example.com

# local dev: memory (in-process) | postgres
PORTER_REPO=memory

# ---- OAuth / security ----
# HS256 signing key for access-token JWTs. REQUIRED in production:
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated per process (tokens die on restart).
# PORTER_JWT_SECRET=

# Per-client rate limit, requests/minute (default 60)
# PORTER_RATE_LIMIT_PER_MINUTE=60

# ---- One-time bootstrap token ----
# Required as the X-Porter-Setup-Token header for the FIRST client
# registration only. If unset, a random token is generated per process and
# logged loudly at startup. Set a stable value for production:
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# PORTER_SETUP_TOKEN=<paste-generated-value>

# ---- Tiered approval / triage ----
# tiered (default: low-risk auto-approves) | strict (everything queues)
PORTER_APPROVAL_MODE=tiered
# Triage ML model: auto (finetuned > zeroshot > heuristic) | zeroshot |
# heuristic | finetuned. Rules always stay as fast pre-filter + fallback.
PORTER_TRIAGE_MODEL=auto
# Path to your fine-tuned triage model (see scripts/finetune_triage.py).
# PORTER_TRIAGE_MODEL_PATH=models/triage-v1
# Sensitivity score threshold for the ML backstop (default 0.65).
# PORTER_TRIAGE_THRESHOLD=0.65
# Max seconds per model inference before falling back to rules (default 2).
# PORTER_TRIAGE_TIMEOUT=2

# ---- Automation ----
# Fact extractor: stub (regex). Real LLM backends are extension points,
# not implemented in this release; setting ollama/openai will fail.
PORTER_LLM_EXTRACTOR=stub
# LLM Wiki entity-graph layer (prototype, default off).
# PORTER_WIKI_ENABLED=0

# ---- Storage ----
# PORTER_SETTINGS_PATH=/data/settings.json
# PORTER_SNAPSHOT_DIR=/data/snapshots
# OAuth bearer token for MCP/sample clients (not an embedder setting).
# PORTER_TOKEN=
